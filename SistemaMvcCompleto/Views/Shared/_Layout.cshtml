@using Microsoft.AspNetCore.Identity
@inject Microsoft.AspNetCore.Identity.UserManager<SistemaCompleto.Models.User> UserManager
@{
    var usuarioLogado = (User.Identity != null && User.Identity.IsAuthenticated) ? await UserManager.GetUserAsync(User) : null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CadastroProdutos</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaCompleto.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="/css/icones/aprovacao.png">
</head>
<body class="d-flex flex-column min-vh-100 bg-dark text-white" style="background-color: #000000 !important;">

    @if (User.Identity != null && User.Identity.IsAuthenticated && usuarioLogado != null)
    {
        <header>
            <nav class="navbar navbar-dark bg-dark border-bottom border-secondary shadow-sm py-2 menu_principal">
                <div class="container-fluid px-3 d-flex align-items-center justify-content-between">

                   
                    <a class="navbar-brand fw-bold d-flex align-items-center fs-5" asp-controller="Produto" asp-action="Index">
                        <i class="bi bi-house-door-fill me-2 text-primary"></i>
                        <span>Home</span>
                    </a>

                    <button class="navbar-toggler border-0 p-1" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="offcanvas offcanvas-end bg-dark text-white" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel" style="max-width: 320px;">

                        <div class="offcanvas-header border-bottom border-secondary">
                            <h5 class="offcanvas-title d-flex align-items-center gap-2 text-white" id="offcanvasNavbarLabel">
                                <i class="bi bi-box-seam text-primary fs-4"></i>
                                <span>Controle de Estoque</span>
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                        </div>

                        <div class="offcanvas-body d-flex flex-column justify-content-between menu">
                            <ul class="navbar-nav fs-5 gap-2 menu_principal">

                                <li class="nav-item mb-2">
                                    <div class="d-flex align-items-center gap-3 p-2 rounded bg-secondary bg-opacity-25">
                                        @if (!string.IsNullOrEmpty(usuarioLogado.FotoUrl))
                                        {
                                            <img src="@usuarioLogado.FotoUrl" alt="Foto de perfil" class="rounded-circle border border-2 border-primary object-fit-cover" style="width: 42px; height: 42px;" />
                                        }
                                        else
                                        {
                                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 42px; height: 42px;">
                                                @(string.IsNullOrEmpty(usuarioLogado.NomeCompleto) ? "?" : usuarioLogado.NomeCompleto.Substring(0, 1).ToUpper())
                                            </div>
                                        }
                                        <div class="d-flex flex-column overflow-hidden">
                                            <span class="text-white fw-bold fs-6 text-truncate">@(usuarioLogado.NomeCompleto ?? usuarioLogado.UserName)</span>
                                            <span class="text-white-50 fs-7">@(User.IsInRole("Admin") ? "Administrador" : "Funcionário")</span>
                                        </div>
                                    </div>
                                </li>

                                <li class="nav-item">
                                    <a asp-controller="Perfil" asp-action="Perfil" class="nav-link text-white d-flex align-items-center gap-2">
                                        <i class="bi bi-person-badge text-primary"></i> Meu Perfil
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white d-flex align-items-center gap-2" asp-controller="Produto" asp-action="Index">
                                        <i class="bi bi-box-seam text-primary"></i> Produtos
                                    </a>
                                </li>

                                @if (User.IsInRole("Admin"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-white d-flex align-items-center gap-2" asp-controller="Usuario" asp-action="ListaFuncionarios">
                                            <i class="bi bi-people text-info"></i> Lista Funcionários
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-white d-flex align-items-center gap-2" asp-controller="Usuario" asp-action="Cadastrar">
                                            <i class="bi bi-person-plus text-success"></i> Cadastrar Usuário
                                        </a>
                                    </li>
                                   
                                }

                                <li class="nav-item">
                                    <a class="nav-link text-white d-flex align-items-center gap-2" asp-controller="Produto" asp-action="Vencimentos">
                                        <i class="bi bi-clock-history text-warning"></i> Próximos do Vencimento
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white d-flex align-items-center gap-2" asp-controller="Produto" asp-action="EstoqueBaixo">
                                        <i class="bi bi-exclamation-triangle text-danger"></i> Estoque Baixo
                                    </a>
                                </li>
                            </ul>

                            <div class="pt-3 border-top border-secondary mt-auto">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="w-100">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger w-100 fw-bold d-flex align-items-center justify-content-center gap-2">
                                        <i class="bi bi-box-arrow-right"></i> Sair
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>

                </div>
            </nav>
        </header>
    }

    <main role="main" class="flex-fill pb-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="border-top border-white mt-auto footer container_footer text-white-50 py-3">
        <div class="container text-center text-white fw-bold">
            <span class="font-monospace">&copy; @DateTime.Now.Year - Cadastro de Produtos. Direitos reservados.</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>