@model IEnumerable<SistemaCompleto.TDO.ProdutoDto>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Relatório de Vencimentos";

    var posicao = 1;
}


<div class="d-flex justify-content-between align-items-center mb-3 botoes_vencimentos">
    <div class="titulovencimento btn btn-danger disabled text-start">
        <h3 class="mb-0"><i class="bi bi-clock-history text-warning me-2"></i>Produtos Próximos do Vencimento e Vencidos</h3>
        <small class="text-white">Itens com vencimento nos próximos 30 dias</small>
    </div>
</div>

<form asp-controller="Produto" asp-action="Vencimentos" method="get" class="row g-2 mb-4 align-items-end container-fluid produtos_vencidos">

    <div class="col-md-3">
        <label class="form-label fw-bold justify-content-center d-flex">Pesquisar</label>
        <input type="text" name="pesquisa" value="@ViewData["FiltroAtual"]" class="form-control text-center text-black fw-bolder" placeholder="Nome do produto..." />
    </div>

    <div class="col-md-3">
        <label class="form-label fw-bold justify-content-center d-flex">Categoria</label>
        <select name="categoria" class="form-select text-black fw-bolder opcoes_produtos">
            <option value="">-- Todas --</option>
            <option value="Achocolatados" selected="@(ViewData["CategoriaAtual"]?.ToString() == "Achocolatados")">Achocolatados</option>
            <option value="Produtos Zero" selected="@(ViewData["CategoriaAtual"]?.ToString() == "Produtos Zero")">Produtos Zero</option>
            <option value="Creme de Leite" selected="@(ViewData["CategoriaAtual"]?.ToString() == "Creme de Leite")">Creme de Leite</option>
            <option value="Leite Condensado" selected="@(ViewData["CategoriaAtual"]?.ToString() == "Leite Condensado")">Leite Condensado</option>
            <option value="Leite em po" selected="@(ViewData["CategoriaAtual"]?.ToString() == "Leite em po")">Leite em pó</option>
            <option value="Outros" selected="@(ViewData["CategoriaAtual"]?.ToString() == "Outros")">Outros</option>
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label fw-bold justify-content-center d-flex">Situação da Validade</label>
        <select name="statusVencimento" class="form-select text-black fw-bolder">
            <option value="todos" selected="@(ViewData["StatusAtual"]?.ToString() == "todos")">Todos (Vencidos e A Vencer)</option>
            <option value="vencidos" selected="@(ViewData["StatusAtual"]?.ToString() == "vencidos")">Apenas Vencidos</option>
            <option value="aVencer" selected="@(ViewData["StatusAtual"]?.ToString() == "aVencer")">Apenas Próximos do Vencimento</option>
            <option value="hoje" selected="@(ViewData["StatusAtual"]?.ToString() == "hoje")">Vencem Hoje</option>
        </select>
    </div>

    <div class="col-md-2 container_botao_filtre">
        <button type="submit" class="btn btn-primary w-100 botao_filtre">
            <i class="bi bi-funnel me-1"></i> Filtrar
        </button>
    </div>
</form>

<div class="border border-secondary rounded-3 shadow overflow-hidden">

    <div class="d-flex justify-content-end flex-wrap gap-2 p-3 bg-dark border-bottom border-secondary">
        <a asp-controller="Produto" asp-action="Index" class="btn btn-primary text-white fw-bold d-flex align-items-center gap-2">
            <i class="bi bi-house-door-fill text-white"></i>
            <span>Home</span>
        </a>

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Produto"
               asp-action="ExportarVencimentos"
               asp-route-pesquisa="@ViewData["FiltroAtual"]"
               asp-route-categoria="@ViewData["CategoriaAtual"]"
               asp-route-statusVencimento="@ViewData["StatusAtual"]"
               class="btn btn-success text-white fw-bold d-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-excel-fill"></i>
                <span>Exportar Vencimentos (Excel)</span>
            </a>
        }
    </div>


    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead class="table-borderless text-uppercase small text-muted border-bottom border-secondary">
                <tr class="text-center">
                    <th scope="col" style="width: 50px;">Id</th>
                    <th scope="col">Produto</th>
                    <th scope="col">Categoria</th>
                    <th scope="col">Validade</th>
                    <th scope="col">Status / Urgência</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var produto in Model)
                    {
                        var diasparavencer = (produto.Validade.Date - DateTime.Now.Date).Days;

                        <tr class="text-center">
               
                            <td class="fw-bold text-white">@posicao</td>

                      
                            <td><span class="fw-semibold text-white">@produto.Nome</span></td>
                            <td><span class="badge bg-secondary">@produto.Categoria</span></td>
-->
                            <td class="text-warning fw-bold">@produto.Validade.ToString("dd/MM/yyyy")</td>

                            <td>
                                @if (diasparavencer > 7)
                                {
                                    <span class="badge bg-info text-dark fs-6">
                                        <i class="bi bi-clock me-1"></i> @diasparavencer dias restantes
                                    </span>
                                }
                                else if (diasparavencer > 0)
                                {
                                    <span class="badge bg-warning text-dark fs-6">
                                        <i class="bi bi-exclamation-triangle me-1"></i> Vence em @diasparavencer dia(s)
                                    </span>
                                }
                                else if (diasparavencer == 0)
                                {
                                    <span class="badge bg-danger text-white fw-bold fs-6">
                                        <i class="bi bi-exclamation-octagon me-1"></i> Vence Hoje!
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger fs-6">
                                        <i class="bi bi-x-circle me-1"></i> Vencido há @Math.Abs(diasparavencer) dia(s)
                                    </span>
                                }
                            </td>
                        </tr>

                        posicao++;
                    }
                }
                else
                {
                    <tr>
       
                        <td colspan="5" class="text-center py-4 text-muted">
                            Nenhum produto próximo do vencimento encontrado.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>