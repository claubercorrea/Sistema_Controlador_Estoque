@model IEnumerable<SistemaCompleto.TDO.ProdutoDto>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Relatório de Estoque Baixo";

    var posicao = 1;
}

<div class="container_vencimentos container_opcoes mt-md-5 ">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="btn btn-warning text-start " style="margin:auto; margin-bottom:2%; margin-top:5%; border-radius:25px; border:1px solid black;">
            <h3 class="mb-0 text-white"><i class="bi bi-box-seam me-2"></i>Produtos com Estoque Baixo</h3>
            <small class="text-white d-flex justify-content-center ">Itens com quantidade igual ou inferior a 10 unidades</small>
        </div>
    </div>

    <form asp-controller="Produto" asp-action="EstoqueBaixo" method="get" class="row g-2 mb-4 align-items-end container-fluid produtos_vencidos">
        <div class="col-md-5">
            <label class="form-label fw-bold justify-content-center text-black d-flex">Pesquisar</label>
            <input type="text" name="pesquisa" value="@ViewData["FiltroAtual"]" class="form-control text-center text-black fw-bolder" placeholder="Nome do produto..." />
        </div>

        <div class="col-md-5">
            <label class="form-label fw-bold justify-content-center text-black d-flex">Categoria</label>
            <select name="categoria" class="form-select text-black fw-bolder opcoes_produtos">
                <option value="">-- Todas --</option>
                <option value="Achocolatados" selected="@(ViewData["CategoriaAtual"]?.ToString() == "Achocolatados")">Achocolatados</option>
                <option value="Produtos Zero" selected="@(ViewData["CategoriaAtual"]?.ToString() == "Produtos Zero")">Produtos Zero</option>
                <option value="Creme de Leite" selected="@(ViewData["CategoriaAtual"]?.ToString() == "Creme de Leite")">Creme de Leite</option>
                <option value="Leite Condensado" selected="@(ViewData["CategoriaAtual"]?.ToString() == "Leite Condensado")">Leite Condensado</option>
                <option value="Leite em po" selected="@(ViewData["CategoriaAtual"]?.ToString() == "Leite em po")">Leite em po</option>
                <option value="Outros" selected="@(ViewData["CategoriaAtual"]?.ToString() == "Outros")">Outros</option>
            </select>
        </div>

        <div class="col-md-2 container_botao_filtre">
            <button type="submit" class="btn btn-primary w-100 botao_filtre">
                <i class="bi bi-funnel me-1"></i> Filtrar
            </button>
        </div>
    </form>


    <div class="border border-secondary rounded-3 shadow overflow-hidden">

        <div class="d-flex justify-content-end flex-wrap gap-2 p-3 bg-dark border-bottom border-secondary">
            <a asp-controller="Produto" asp-action="Index" class="btn btn-primary text-white fw-bold d-flex align-items-center gap-2">
                <i class="bi bi-house-door-fill text-white"></i>
                <span>Home</span>
            </a>

            @if (User.IsInRole("Admin"))
            {
       
                <a asp-controller="Produto"
                   asp-action="ExportarEstoqueBaixo"
                   asp-route-pesquisa="@ViewData["FiltroAtual"]"
                   asp-route-categoria="@ViewData["CategoriaAtual"]"
                   class="btn btn-success text-white fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-excel-fill"></i>
                    <span>Exportar Estoque (Excel)</span>
                </a>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0 text-center">
                <thead class="table-borderless text-uppercase small text-muted border-bottom border-secondary">
                    <tr>
                        <th scope="col" style="width: 50px;">#</th>
                        <th scope="col" style="width: 80px;">ID</th>
                        <th scope="col">Produto</th>
                        <th scope="col">Categoria</th>
                        <th scope="col">Quantidade</th>
                        <th scope="col">Validade</th>
                        <th scope="col" style="width: 120px;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var produto in Model)
                        {
                            <tr>
                                <td class="fw-bold text-muted">@posicao</td>

                                <td class="fw-bold">@produto.Id</td>

                                <td><span class="fw-semibold text-white">@produto.Nome</span></td>
                                <td><span class="badge bg-secondary">@produto.Categoria</span></td>

                                <td>
                                    <span class="badge bg-danger fs-6 fw-bold">
                                        <i class="bi bi-exclamation-circle me-1"></i> @produto.QuantidadeEstoque unid.
                                    </span>
                                </td>

                                <td class="text-warning fw-bold">@produto.Validade.ToString("dd/MM/yyyy")</td>

                                <td>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalExcluirEstoque"
                                                data-id="@produto.Id"
                                                data-nome="@produto.Nome"
                                                title="Excluir do Banco">
                                            <i class="bi bi-trash"></i> Excluir
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sem permissão</span>
                                    }
                                </td>
                            </tr>

                            posicao++;
                        }
                    }
                    else
                    {
                   
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                                    <i class="bi bi-search-heart display-5 mb-2 text-warning"></i>

                                    @if (!string.IsNullOrEmpty(ViewData["FiltroAtual"]?.ToString()) || !string.IsNullOrEmpty(ViewData["CategoriaAtual"]?.ToString()))
                                    {
                                        <h5 class="fw-bold text-white mb-1">Nenhum produto encontrado</h5>
                                        <p class="mb-3 text-secondary">Não encontramos nenhum item com estoque baixo para os filtros aplicados.</p>
                                        <a asp-controller="Produto" asp-action="EstoqueBaixo" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-x-circle me-1"></i> Limpar Filtros
                                        </a>
                                    }
                                    else
                                    {
                                        <h5 class="fw-bold text-white mb-1">Nenhum estoque crítico</h5>
                                        <p class="mb-0 text-secondary">Todos os produtos estão com níveis de estoque adequados (acima de 10 unidades).</p>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalExcluirEstoque" tabindex="-1" aria-labelledby="modalExcluirEstoqueLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border border-secondary shadow">
            <div class="modal-header border-bottom border-secondary">
                <h5 class="modal-title text-danger fw-bold text-center d-flex justify-content-center align-items-center" id="modalExcluirEstoqueLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Exclusão
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="fs-5 mb-2">Tem certeza que deseja excluir o produto abaixo?</p>
                <p class="fw-bold text-warning fs-4 mb-0" id="nomeProdutoModal"></p>
                <small class="text-muted">Esta ação excluirá permanentemente o item do banco de dados.</small>
            </div>
            <div class="modal-footer border-top border-secondary d-flex justify-content-center gap-3">
                <button type="button" class="btn btn-danger px-4 fw-bold" data-bs-dismiss="modal">Cancelar</button>

                <form id="formExcluirModal" asp-controller="Produto" asp-action="Excluir" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="idProdutoModal" name="id" value="" />
                    <button type="submit" class="btn btn-primary px-4 fw-bold">
                        <i class="bi bi-trash me-1"></i> Confirmar Exclusão
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modalExcluir = document.getElementById('modalExcluirEstoque');

            if (modalExcluir) {
                modalExcluir.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;

                    var produtoId = button.getAttribute('data-id');
                    var produtoNome = button.getAttribute('data-nome');

                    document.getElementById('nomeProdutoModal').textContent = produtoNome;
                    document.getElementById('idProdutoModal').value = produtoId;
                });
            }
        });
    </script>
}