
@using Microsoft.AspNetCore.Identity
@inject Microsoft.AspNetCore.Identity.UserManager<SistemaCompleto.Models.User> UserManager

@{
    var usuarioLogado = (User.Identity != null && User.Identity.IsAuthenticated) ? await UserManager.GetUserAsync(User) : null;
}

@model IEnumerable<SistemaCompleto.TDO.ProdutoDto>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Consulta de Produtos";
    
    ViewData["Title"] = "Listagem de Produtos";

}

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/SistemaCompleto.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

 
<div class=" container  text-center d-flex justify-content-center btn btn-primary text-start w-50" style="margin:auto; margin-bottom:2%; margin-top:5%; border-radius:25px; border:1px solid black;">
    <h3 class="mb-0 text-white">Olá, Seja Bem-vindo! @(usuarioLogado?.NomeCompleto ?? "Usuário")</h3>

</div>

 <div class="container mt-5 mb-3 container_tabela_produtos  container_opcoes">

    <div class="d-flex  btn-3d w justify-content-center mt-3 align-items-center container  container_titulo flex-column" >
      
         

       
            @if (TempData["Mensagem"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-3 w-100" role="alert">
                    @TempData["Mensagem"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>
    <div class="btn btn-primary text-start d-flex justify-content-center w-50 text-center" style="margin:auto; margin-bottom:2%; margin-top:5%; border-radius:25px; border:1px solid black;">
    <h3 class="mb-0 text-white"><i class="bi bi-box-seam me-2"></i>Consulta de Produtos </h3>

</div>
        <!-- Formulário unificado de Filtros -->
        <form asp-controller="Produto" asp-action="Index" method="get" class="row g-2 mb-4 align-items-end mt-3 ">
            <div class="col-md-4">
                <label class="form-label fw-bold text-black">Pesquisa</label>
                <input type="text" name="pesquisa" value="@ViewData["FiltroAtual"]" class="form-control" placeholder="Pesquisar produto..." />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold text-black">Categoria</label>
                <select name="categoria" class="form-select text-black fw-bolder opcoes_produtos">
                    <option value="" class="text-black fw-bolder">-- Todas --</option>
                    <option value="Achocolatados" selected="@(ViewData["CategoriaAtual"]?.ToString() == "Achocolatados")">Achocolatados</option>
                    <option value="Produtos Zero" selected="@(ViewData["CategoriaAtual"]?.ToString() == "Produtos Zero")">Produtos Zero</option>
                    <option value="Creme de Leite" selected="@(ViewData["CategoriaAtual"]?.ToString() == "Creme de Leite")">Creme de Leite</option>
                    <option value="Leite Condensado" selected="@(ViewData["CategoriaAtual"]?.ToString() == "Leite Condensado")">Leite Condensado</option>
                    <option value="Leite em po" selected="@(ViewData["CategoriaAtual"]?.ToString() == "Leite em po")">Leite em pó</option>
                    <option value="Outros" selected="@(ViewData["CategoriaAtual"]?.ToString() == "Outros")">Outros</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2 w-25">
            <button type="submit" class="  btn btn-primary btn-3d flex-grow-1">Filtrar</button>
                <a asp-controller="Produto" asp-action="Index" class="btn btn-danger ">Limpar</a>
            </div>

        </form>

        <!-- Botões de Ação Superior (Adicionar, Exportar e Excluir Todos) -->
        @if (User.IsInRole("Admin"))
        {   
            <div class="mb-3 d-flex gap-2 justify-content-end container_addProduto flex-wrap">
            <a asp-controller="Produto" asp-action="Create" class="btn btn-primary btn-3d  d-flex justify-content-center align-items-center">
                <i class="bi bi-box-seam me-2 btn-3d"></i>Adicionar Produto
                </a>

                <form asp-controller="Produto" asp-action="ExportarExcel" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                <button type="submit" class="  btn btn-success btn-3d d-flex align-items-center">
                    <i class="bi bi-file-earmark-excel me-1 btn-3d"></i> Exportar Excel
                    </button>
                </form>

                @if (Model != null && Model.Any())
                {
                <button type="button" class="btn btn-danger btn-3d" data-bs-toggle="modal" data-bs-target="#modalExcluirTodos">
                    <i class="bi bi-trash me-1 btn-3d"></i> Excluir Todos
                    </button>
                }
            </div>
        }

        <!-- Tabela de Produtos -->
    <div class="table-responsive container-responsive bg-dark container-tabela" style="overflow-x: auto; width: 100%;">
        <table class="table  table-dark table-hover table-striped table-hover align-middle border">
                <thead class="table-dark text-center">
                    <tr>
                        <th>ID</th>
                        <th>Produto</th>
                        <th>Categoria</th>
                        <th>Preço</th>
                        <th>Quantidade</th>
                        <th>Validade</th>
                        <th>Código de Barras</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th class="text-center">Ações</th>
                        }
                    </tr>
                </thead>
                <tbody class="text-center ">
                    @if (Model == null || !Model.Any())
                    {
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                                <i class="bi bi-search-heart display-5 mb-2 text-warning"></i>

                                @if (!string.IsNullOrEmpty(ViewData["FiltroAtual"]?.ToString()) || !string.IsNullOrEmpty(ViewData["CategoriaAtual"]?.ToString()))
                                {
                                    <h5 class="fw-bold text-white mb-1">Nenhum produto encontrado</h5>
                                    <p class="mb-3 text-secondary">Não encontramos nenhum item com estoque baixo para os filtros aplicados.</p>
                                    <a asp-controller="Produto" asp-action="Index" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-x-circle me-1"></i> Limpar Filtros
                                    </a>
                                }
                                else
                                {
                                    <h5 class="fw-bold text-white mb-1">Nenhum estoque crítico</h5>
                                    <p class="mb-0 text-secondary">Todos os produtos estão com níveis de estoque adequados (acima de 10 unidades).</p>
                                }
                            </div>
                        </td>
                    </tr>
                    }
                    else
                    {
                        @foreach (var produto in Model)
                        {
                            <tr class="fw-bolder">
                                <td>@produto.Id</td>
                                <td class="fw-bold">@produto.Nome</td>

                                <!-- Categoria -->
                                <td>
                                    <span class="badge bg-success bg-gradient text-white">@produto.Categoria</span>
                                </td>

                                <!-- Preço -->
                                <td>@produto.Preco.ToString("C")</td>

                                <!-- Quantidade -->
                                <td class="text-center">
                                    <span class="fw-bold @(produto.QuantidadeEstoque <= 10 ? "text-danger" : "text-white")">
                                        @produto.QuantidadeEstoque un
                                    </span>
                                </td>

                                <!-- Validade -->
                                <td class="text-center">
                                    <span class="badge bg-dark border border-secondary text-light px-2 py-1">
                                        <i class="bi bi-calendar-event me-1"></i>@produto.Validade.ToString("dd/MM/yyyy")
                                    </span>
                                </td>

                                <!-- Código de barras -->
                                <td>@produto.Codigo_barra</td>

                                @if (User.IsInRole("Admin"))
                                {
                                    <td class="text-center align-middle">
                                        <div class="d-flex flex-column flex-sm-row justify-content-center align-items-center gap-1">
                                            <!-- Botão Editar -->
                                            <a asp-controller="Produto" asp-action="Editar" asp-route-id="@produto.Id"
                                           class="btn btn-sm btn-secondary btn-3d text-white d-inline-flex align-items-center justify-content-center w-100 w-sm-auto">
                                            <i class="bi bi-pencil-square btn-3d"></i>
                                                <span class="d-none d-md-inline ms-1 ">Editar</span>
                                            </a>

                                            <!-- Botão Excluir -->
                                            <button type="button"
                                                    class="excluir btn btn-sm btn-danger text-white d-inline-flex align-items-center justify-content-center w-100 w-sm-auto"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalExcluir"
                                                    data-id="@produto.Id"
                                                    data-nome="@produto.Nome">
                                                <i class="bi bi-trash"></i>
                                                <span class="d-none d-md-inline ms-1">Excluir</span>
                                            </button>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

<!-- Modal de Exclusão Unitária -->
<div class="modal fade" id="modalExcluir" tabindex="-1" aria-labelledby="modalExcluirLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border border-secondary shadow">
            <div class="modal-header border-bottom border-secondary">
                <h5 class="modal-title text-danger fw-bold" id="modalExcluirLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Exclusão
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="fs-5 mb-2">Tem certeza que deseja excluir o produto abaixo?</p>
                <p class="fw-bold text-warning fs-4 mb-0" id="nomeProduto"></p>
                <small class="text-muted">Esta ação excluirá permanentemente o item do banco de dados.</small>
            </div>
            <div class="modal-footer border-top border-secondary d-flex justify-content-center gap-3">
                <button type="button" class="btn btn-danger px-4 fw-bold" data-bs-dismiss="modal">Cancelar</button>

                <form asp-controller="Produto" asp-action="Excluir" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="idProduto" name="id" value="" />
                    <button type="submit" class="btn btn-primary px-4 fw-bold">
                        <i class="bi bi-trash me-1"></i> Sim, Excluir
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Exclusão de Todos os Produtos -->
<div class="modal fade" id="modalExcluirTodos" tabindex="-1" aria-labelledby="modalExcluirTodosLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border border-secondary shadow">
            <div class="modal-header border-bottom border-secondary">
                <h5 class="modal-title text-danger fw-bold" id="modalExcluirTodosLabel">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i>Atenção: Exclusão Geral
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="fs-5 mb-2">Tem certeza que deseja apagar <strong class="text-danger">TODOS</strong> os produtos?</p>
                <p class="text-warning fw-bold mb-0">Esta ação irá limpar a tabela por completo!</p>
                <small class="text-muted">Essa operação não poderá ser desfeita.</small>
            </div>
            <div class="modal-footer border-top border-secondary d-flex justify-content-center gap-3">
                <button type="button" class="btn btn-danger px-4 fw-bold" data-bs-dismiss="modal">Cancelar</button>

                <form asp-controller="Produto" asp-action="ExcluirTodos" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary px-4 fw-bold">
                        <i class="bi bi-trash-fill me-1"></i> Sim, Excluir Tudo
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
        <script>
            var modalExcluir = document.getElementById('modalExcluir');
            if (modalExcluir) {
                modalExcluir.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    var id = button.getAttribute('data-id');
                    var nome = button.getAttribute('data-nome');

                    modalExcluir.querySelector('#idProduto').value = id;
                    modalExcluir.querySelector('#nomeProduto').textContent = nome;
                });
            }
        </script>
}


