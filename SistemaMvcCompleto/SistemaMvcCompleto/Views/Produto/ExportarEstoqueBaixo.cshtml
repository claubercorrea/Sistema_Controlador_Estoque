@model IEnumerable<SistemaCompleto.TDO.ProdutoDto>

@{
    ViewData["Title"] = "Estoque Crítico";
}

<div class="d-flex justify-content-between align-items-center  flex-wrap gap-2">
    <div>
        <h3 class="text-danger "><i class="bi bi-exclamation-triangle-fill me-2"></i>Produtos com Estoque Baixo</h3>
        <small class="text-muted">Itens com quantidade igual ou inferior a 10 unidades</small>
    </div>

    <!-- BOTÃO DEDICADO: EXPORTAR ESTOQUE BAIXO -->
    <a asp-controller="Produto" asp-action="ExportarEstoqueBaixo" class="btn btn-danger d-flex align-items-center gap-2">
        <i class="bi bi-file-earmark-excel-fill"></i> Exportar Estoque Baixo (Excel)
    </a>
</div>

<!-- TABELA DE ESTOQUE BAIXO -->
<div class="table-responsive rounded-3 shadow">
    <table class="table table-dark table-hover align-middle mb-0">
        <thead class="table-borderless text-uppercase small text-muted">
            <tr>
                <th scope="col" class="text-center" style="width: 80px;">Código</th>
                <th scope="col">Produto</th>
                <th scope="col">Categoria</th>
                <th scope="col" class="text-center">Quantidade Atual</th>
                <th scope="col" class="text-center">Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center fw-bold">#@item.Id</td>
                        <td><span class="fw-semibold text-white">@item.Nome</span></td>
                        <td><span class="badge bg-secondary">@item.Categoria</span></td>
                        <td class="text-center">
                            <span class="badge bg-danger text-white fs-6">@item.Nome un</span>
                        </td>
                        <td class="text-center">
                            <span class="text-danger fw-bold"><i class="bi bi-arrow-down-circle me-1"></i>Reposição Necessária</span>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center py-4 text-muted">Nenhum produto em nível crítico no momento.</td>
                </tr>
            }
        </tbody>
    </table>
</div>