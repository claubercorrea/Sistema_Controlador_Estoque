@model SistemaCompleto.TDO.LoginDto

@{
    ViewData["Title"] = "Login";
}

<link rel="stylesheet" href="~/CadastroProdutos.styles.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="container  movimentar_login " >
    <div class="row justify-content-center  d-flex justify-content-center align-items-center vh-100 " style="border-radius:25px;">
        <div class="col-md-5 ">
            <div class="card  container shadow-sm container_cadastra_funcionario  ">

                <!-- Cabeçalho -->
                <div class="card bg-dark text-white text-center py-3 container_vidro_login  mt-3">
                    <h3 style=" font-size:1rem; text-align:center;">
                        <img src="/css/icones/estoque-pronto.png" alt="Logo" class="me-3 " style="max-width:auto; height:auto; " />
                        CONTROLE DE ESTOQUE
                    </h3>
                </div>

                <div class="card-body p-4 ">

                    <!-- Exibe mensagens globais (ex: E-mail ou senha inválidos) -->
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center "></div>

                    <form asp-action="Login" method="post" autocomplete="off">

                        <!-- Preserva a URL de retorno se o usuário tentar acessar uma rota restrita -->
                        <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]" />

                        <!-- Campo E-mail -->
                        <div class="form-group mb-3 d-flex justify-content-center align-items-center flex-column">
                            <label asp-for="Email" class="form-label fw-bold text-center d-flex justify-content-center align-items-center ">E-mail</label>
                            <input asp-for="Email" class="form-control border-primary w-auto" placeholder="usuario@deposito.com" autocomplete="username" />
                            <span asp-validation-for="Email" class="text-danger small d-block text-center mt-1"></span>
                        </div>

                        <!-- Campo Senha -->
                        <div class="form-group mb-3 d-flex justify-content-center align-items-center flex-column">
                            <label asp-for="Senha" class="form-label fw-bold text-center ">Senha</label>
                            <input asp-for="Senha" type="password" class="form-control border-primary w-auto " placeholder="Digite sua senha" autocomplete="current-password" />
                            <span asp-validation-for="Senha" class="text-danger small d-block text-center mt-1"></span>
                        </div>

                        <!-- Botão Entrar -->
                        <div class="d-grid justify-content-center d-flex mt-4 d-flex justify-content-center align-items-center flex-column">
                            <button type="submit" class="btn btn-primary btn-3d w-20 px-4 logar ">Entrar</button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}